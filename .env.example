# ── Copy this to .env and fill in your keys ──────────────────────
# Never commit .env to git.

# Stage 1 — Ocean.io
# Sign up at ocean.io using a company email (requires your own domain)
OCEAN_API_KEY=your_ocean_api_key_here

# Stage 2 — Prospeo
# Get key at: https://app.prospeo.io/api
PROSPEO_API_KEY=your_prospeo_api_key_here

# Stage 3 — Eazyreach
# Credits provided by Vocallabs — create account at eazyreach.app
# Uses OAuth2 client credentials flow
EAZYREACH_CLIENT_ID=your_eazyreach_client_id_here
EAZYREACH_CLIENT_SECRET=your_eazyreach_client_secret_here

# Stage 4 — Brevo
# Get key at: https://app.brevo.com → Settings → API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Must match a verified sender in your Brevo account
SENDER_NAME=Your Full Name
SENDER_EMAIL=you@yourdomain.com

# Optional: set to any value to enable verbose debug logs
# DEBUG=1
